---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod><priority>1.0</priority></url>
{%- assign pages = "/projets.html,/a-propos.html,/contact.html" | split: "," %}
{%- for chemin in pages %}
  <url><loc>{{ chemin | absolute_url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod><priority>0.9</priority></url>
{%- endfor %}
{%- assign projets = site.projets | where_exp: "p", "p.afficher != false" | sort: "ordre", "last" %}
{%- for p in projets %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod><priority>0.8</priority></url>
{%- endfor %}
  <url><loc>{{ '/cv.html' | absolute_url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod><priority>0.7</priority></url>
</urlset>
